#!/bin/sh
# Inspect outgoing history as well as the tip, so a later deletion cannot hide
# experimental files in a merge or an incorrectly targeted push.
zero=0000000000000000000000000000000000000000
while read -r local_ref local_oid remote_ref remote_oid; do
    [ "$local_oid" = "$zero" ] && continue
    [ "$remote_ref" = "refs/heads/experimental" ] && continue
    # Non-commit objects cannot contain this directory in a commit tree.
    git cat-file -e "$local_oid^{commit}" 2>/dev/null || continue
    if [ "$remote_oid" != "$zero" ] && git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
        commits=$(git rev-list "$local_oid" "^$remote_oid") || exit 1
    else
        commits=$(git rev-list "$local_oid") || exit 1
    fi
    # Check the tip even when the remote already has the outgoing history.
    for commit in "$local_oid" $commits; do
        files=$(git ls-tree -r --name-only "$commit" -- experimentals) || exit 1
        if [ -n "$files" ]; then
            echo "Blocked: experimentals/ exists in commits being pushed to $remote_ref." >&2
            echo "Push experiments only to refs/heads/experimental." >&2
            exit 1
        fi
    done
done
