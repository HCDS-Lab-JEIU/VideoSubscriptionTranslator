QMainWindow,
QDialog,
QMessageBox {
    background-color: #0d1117;
    color: #c9d1d9;
}

QWidget {
    background-color: #0d1117;
    color: #e6edf3;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QLineEdit,
QPlainTextEdit,
QTextEdit,
QComboBox {
    background-color: #161b22;
    color: #f0f6fc;
    border: 1px solid #6e7681;
    border-radius: 4px;
    padding: 5px;
    selection-background-color: #264f78;
    selection-color: #ffffff;
    placeholder-text-color: #a5afbb;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QComboBox:focus {
    border-color: #58a6ff;
}

QLineEdit:read-only {
    background-color: #0d1117;
    color: #b7c2cf;
}

QComboBox {
    padding-right: 24px;
}

QComboBox QAbstractItemView {
    background-color: #161b22;
    color: #f0f6fc;
    border: 1px solid #6e7681;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

QTableView {
    background-color: #0d1117;
    alternate-background-color: #1c2430;
    color: #f0f6fc;
    gridline-color: #394452;
    border: 1px solid #6e7681;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

QTableView::item:selected,
QComboBox QAbstractItemView::item:selected {
    background-color: #264f78;
    color: #ffffff;
}

QHeaderView::section,
QTableCornerButton::section {
    background-color: #212b38;
    color: #f0f6fc;
    border: 1px solid #394452;
    padding: 6px;
}

QSplitter::handle {
    background-color: #394452;
}

QSplitter::handle:hover {
    background-color: #58a6ff;
}

QPushButton:disabled,
QComboBox:disabled {
    background-color: #161b22;
    color: #9ba7b5;
    border-color: #394452;
}

QVideoWidget {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
}

#timeLabel {
    color: #8b949e;
    font-size: 9pt;
}

#playButton {
    font-size: 10pt;
    padding: 0;
}

#volumeLabel {
    color: #8b949e;
    font-size: 9pt;
}

#playerControls {
    background-color: transparent;
}

#audioWaveVisualizer {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
}

QMenuBar {
    background-color: #161b22;
    color: #c9d1d9;
    border-bottom: 1px solid #30363d;
    padding: 3px;
}

QMenuBar::item {
    background-color: transparent;
    border-radius: 4px;
    padding: 5px 10px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #21262d;
    color: #f0f6fc;
}

QMenu {
    background-color: #161b22;
    color: #c9d1d9;
    border: 1px solid #30363d;
    padding: 4px;
}

QMenu::item {
    border-radius: 4px;
    padding: 6px 28px 6px 10px;
}

QMenu::item:selected {
    background-color: #1f6feb;
    color: #ffffff;
}

QMenu::separator {
    background-color: #30363d;
    height: 1px;
    margin: 4px 8px;
}

QStatusBar {
    background-color: #161b22;
    color: #8b949e;
    border-top: 1px solid #30363d;
}

QStatusBar::item {
    border: none;
}

QPushButton {
    background-color: #21262d;
    color: #c9d1d9;
    border: 1px solid #363b42;
    border-radius: 6px;
    padding: 5px 14px;
}

QPushButton:hover {
    background-color: #30363d;
    border-color: #8b949e;
}

QPushButton:pressed {
    background-color: #161b22;
}

QPushButton:default {
    background-color: #238636;
    color: #ffffff;
    border-color: #2ea043;
}

QSlider::groove:horizontal {
    background-color: #30363d;
    border-radius: 2px;
    height: 4px;
}

QSlider::sub-page:horizontal {
    background-color: #1f6feb;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #c9d1d9;
    border: 1px solid #0d1117;
    border-radius: 7px;
    width: 14px;
    margin: -5px 0;
}

QSlider::handle:horizontal:hover {
    background-color: #58a6ff;
}

QToolTip {
    background-color: #161b22;
    color: #f0f6fc;
    border: 1px solid #30363d;
    padding: 4px;
}

QScrollBar:vertical {
    background-color: #0d1117;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #484f58;
    border-radius: 5px;
    min-height: 24px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #6e7681;
}

QScrollBar:horizontal {
    background-color: #0d1117;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #484f58;
    border-radius: 5px;
    min-width: 24px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #6e7681;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
}
